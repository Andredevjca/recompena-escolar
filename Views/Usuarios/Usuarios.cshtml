@model CadastroUsuario
@{
    ViewData["Titulo"] = "Usuários"; var usuarios = (List<UsuarioEscolar>)ViewBag.Usuarios;
}
<div class="pagina-cabecalho">
    <div><span class="sobretitulo">QUEM CUIDA DESSA JORNADA</span>
        <h2>Usuários</h2>
        <p>Acesso reservado aos responsáveis da família.</p>
    </div>
</div>
<div class="detalhe-grade">
    <section class="cartao">
        <div class="cartao-cabecalho">
            <h2>Pessoas com acesso</h2>
        </div>@foreach(var usuario in usuarios){
        <div class="usuario-lista-linha"><span
            class="mini-avatar">@usuario.Nome[0]</span>
            <div><strong>@usuario.Nome</strong><small>@usuario.Email</small></div><span
            class="etiqueta-suave prevista">@usuario.Perfil</span>
        </div>
    }
</section>
<section class="cartao formulario-cartao">
    <h2>Cadastrar usuário</h2>
    <form asp-controller="Usuarios" asp-action="Usuarios" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div><label
        asp-for="Nome">Nome</label><input asp-for="Nome" class="form-control" required minlength="2"
                                          maxlength="100" /><label asp-for="Email">E-mail</label><input asp-for="Email" type="email"
                                                                      class="form-control" required maxlength="180" /><label asp-for="Senha">Senha inicial</label><input
        name="Senha" id="Senha" type="password" class="form-control" required minlength="8" maxlength="128"
        autocomplete="new-password" /><small class="formulario-orientacao">Use pelo menos 8
        caracteres.</small><label asp-for="Perfil">Perfil</label><select asp-for="Perfil" class="form-select">
        <option>Responsável</option>
        <option>Administrador</option>
    </select>
    <div class="formulario-acoes"><button class="btn btn-primary">Cadastrar usuário</button></div>
</form>
</section>
</div>
