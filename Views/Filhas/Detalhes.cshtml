@model ModeloPainel
@{
    var filha = (Filha)ViewBag.Filha; var boletim = Model.Atual(filha.Id); ViewData["Titulo"] = filha.Nome; var
    notas = (List<Nota>)ViewBag.Notas;
}
<div class="pagina-cabecalho">
    <div><a class="texto-ligacao" asp-controller="Filhas" asp-action="Filhas"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Minhas
        Filhas</a>
        <h2>As conquistas de @filha.Nome</h2>
        <p>@filha.Escolaridade • @Model.SemestreSelecionado?.Descricao</p>
    </div><a asp-controller="Boletins" asp-action="Boletins" class="btn btn-primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Lançar
    boletim</a>
</div>
<div class="detalhe-grade">
    <section class="cartao">
        <div class="cartao-cabecalho">
            <h2>Notas por disciplina</h2><span class="etiqueta-suave prevista">@(notas.Count) disciplinas</span>
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Disciplina</th>
                        <th class="text-end">Nota</th>
                    </tr>
                </thead>
                <tbody>@foreach(var nota in notas){
                    <tr>
                        <td>@nota.Disciplina</td>
                        <td class="text-end"><strong>@nota.Valor.ToString("N2")</strong></td>
                    </tr>
                }
                @if (!notas.Any())
                {
                    <tr>
                        <td colspan="2" class="p-4">Nenhum boletim lançado neste semestre.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
<section class="cartao conquista-cartao"><span class="conquista-icone"><i class="fa-solid fa-award"
                                                                              aria-hidden="true"></i></span>
    <h2>Cada esforço conta!</h2>
    <p>Média geral do semestre</p><strong class="grande-media">@(boletim?.MediaGeral.ToString("N2") ?? "—")</strong>
    <p>Recompensa: <strong>@(boletim?.Valor.ToString("C") ?? "—")</strong></p><span
    class="etiqueta-suave @(boletim?.Pago == true ? "pago" : "pendente")">@(boletim == null ? "Aguardando boletim" : boletim.Pago ? "Pago" : "Aguardando pagamento")</span>
</section>
</div>
