@model CadastroFilha
@{
    ViewData["Titulo"] = "Cadastrar filha";
}
<div class="pagina-cabecalho">
    <div><a class="texto-ligacao" asp-controller="Filhas" asp-action="Filhas"><i class="fa-solid fa-arrow-left"
                                                                                     aria-hidden="true"></i> Minhas
        Filhas</a>
        <h2>Uma nova jornada</h2>
        <p>Vamos acompanhar as próximas conquistas.</p>
    </div>
</div>
<section class="cartao formulario-cartao">
    <form asp-controller="Filhas" asp-action="NovaFilha" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div><label asp-for="Nome">Nome da
        filha</label><input asp-for="Nome" class="form-control" placeholder="Como ela se chama?" required
                            minlength="2" maxlength="80" /><label asp-for="Escolaridade">Etapa escolar</label><select
        asp-for="Escolaridade" class="form-select">
        <option>Ensino Fundamental</option>
        <option>Ensino Médio</option>
        <option>Ensino Superior</option>
    </select>
    <p class="formulario-orientacao">O avatar com a inicial será usado enquanto não houver foto cadastrada.</p>
    <div class="formulario-acoes"><a class="btn btn-light" asp-controller="Filhas"
                                         asp-action="Filhas">Cancelar</a><button class="btn btn-primary">Cadastrar filha</button></div>
    </form>
</section>
